{
	"name": "@xkore/triple-ratchet",
	"version": "0.1.4",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/visionsofparadise/triple-ratchet.git"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepare": "node -e \"import('node:child_process').then(({execSync})=>{try{execSync('git rev-parse --is-inside-work-tree',{stdio:'ignore'});execSync('git config core.hooksPath .githooks')}catch{}})\" && node tools.mjs install",
		"build": "tsup",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"eslint . --fix --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"node tools.mjs run actionlint\"",
		"unit": "vitest run unit",
		"integration": "vitest run integration --no-file-parallelism",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@noble/ciphers": "^2.0.1",
		"@noble/curves": "^2.0.1",
		"@noble/hashes": "^1.5.0",
		"@noble/post-quantum": "^0.5.2",
		"@scure/base": "^1.2.4",
		"bufferfy": "^3.0.7",
		"events": "^3.3.0",
		"uint8array-tools": "^0.0.9"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/compat": "^1.3.2",
		"@eslint/js": "^9.28.0",
		"@html-eslint/eslint-plugin": "^0.44.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/events": "^3.0.3",
		"@types/node": "^22.0.0",
		"concurrently": "^9.2.1",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-barrel-files": "^3.0.1",
		"eslint-plugin-comment-rules": "^0.1.7",
		"eslint-plugin-import-x": "^4.15.0",
		"globals": "^16.2.0",
		"jscpd": "^5.0.12",
		"knip": "^6.29.0",
		"markdownlint-cli2": "^0.23.1",
		"prettier": "^3.6.2",
		"textlint": "^15.2.2",
		"textlint-filter-rule-comments": "^1.2.2",
		"textlint-rule-no-dead-link": "^6.2.1",
		"tsup": "^8.0.0",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.33.1",
		"vitest": "^4.0.3"
	},
	"allowScripts": {
		"esbuild@0.25.11": true,
		"unrs-resolver@1.11.1": true
	}
}
